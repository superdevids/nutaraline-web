# Copy to .env.local and adjust per environment.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Base URL of the Nutaraline gateway API used by normal HTTP requests.
NEXT_PUBLIC_API_URL=https://api.nutaraline.co.uk/v1

# WebSocket endpoint used for realtime streams (live metrics, notifications).
NEXT_PUBLIC_WS_URL=wss://api.nutaraline.co.uk/ws

# Deployment mode: "development" shows demo banners, "production" hides them.
NEXT_PUBLIC_ENV=production
